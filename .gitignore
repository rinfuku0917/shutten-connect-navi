# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# 調査で使う一時スクリプト。
# リポジトリ直下に置かないと node_modules が見えないため、
# DBを数えるときは直下に .mjs を作って消す運用になっている。
# 消し忘れがコミットに混ざったことがあるので、ここで塞いでおく。
_tmp*.mjs
_seo_*.mjs
tmp-*.mjs
